{
  "name": "codex-local-hub",
  "version": "0.2.19",
  "private": true,
  "type": "module",
  "description": "Local-first macOS dashboard for monitoring and controlling ChatGPT Codex tasks from your phone.",
  "homepage": "https://makorise.github.io/codex-local-hub/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makorise/codex-local-hub.git"
  },
  "bugs": {
    "url": "https://github.com/makorise/codex-local-hub/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "openai-codex",
    "codex-cli",
    "codex-desktop",
    "codex-mobile",
    "codex-dashboard",
    "codex-remote",
    "mobile-dashboard",
    "phone-remote-control",
    "local-network",
    "local-first",
    "task-monitor",
    "task-queue",
    "macos",
    "pwa"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "docs:preview": "node scripts/docs-preview.mjs",
    "site:preview": "node scripts/site-preview.mjs",
    "build:mac": "zsh scripts/build-macos-app.sh",
    "package:core": "zsh scripts/package-core.sh",
    "package:mac": "zsh scripts/package-macos.sh",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=src/account.mjs --test-coverage-include=src/control.mjs --test-coverage-include=src/core.mjs --test-coverage-include=src/deliveries.mjs --test-coverage-include=src/rollout.mjs --test-coverage-include=src/repository.mjs --test-coverage-include=src/server.mjs --test-coverage-include=src/usage.mjs --test-coverage-include=public/app.js --test-coverage-include=public/i18n.js --test-coverage-include=website/app.js"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "codexLocalHub": {
    "minimumCoreHostVersion": "0.2.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.0"
  }
}
